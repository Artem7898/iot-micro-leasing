# Local development only; the services bind to loopback by default.
ENVIRONMENT=development
IOT_STATE_DIR=.local/state
# Leave DATABASE_URL unset for SQLite in IOT_STATE_DIR.
REDIS_URL=redis://127.0.0.1:6379/0
AUTO_CREATE_SCHEMA=false
# Set API_KEY securely and change this to true to enable gateway authentication.
API_AUTH_ENABLED=false
RATE_LIMIT_ENABLED=true
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production requires ENVIRONMENT=production, PostgreSQL, API_AUTH_ENABLED=true,
# a securely supplied API_KEY (32+ chars), DJANGO_DEBUG=false and DJANGO_SECRET_KEY.
# Optional PostgreSQL container: supply POSTGRES_PASSWORD securely before compose up.
